#!/usr/bin/env sh
# Managed by cargo-husky — installed into .git/hooks on `cargo test`.
# Fast static gate (format + clippy) via the shared Rust lp-ci engine.
# Heavier test/build run on pre-push.
set -e

if ! command -v lp-ci >/dev/null 2>&1; then
    echo "lp-ci not found; installing the shared gate from service-toolkit…"
    cargo install --git https://github.com/LeavePulse/service-toolkit.git \
        --branch main service-toolkit-rust \
        --no-default-features --features cli --bin lp-ci
fi

exec lp-ci --no-test --no-build --no-audit --no-machete
